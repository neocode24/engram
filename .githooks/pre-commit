#!/bin/sh
# 커밋 전 검사 (ADR 0024).
# 활성화: git config core.hooksPath .githooks
#
# 공개 경계 검사는 private/boundary-patterns.txt 가 있는 기계에서만 동작한다.
# 그 파일이 없으면 건너뛴다. CI 에서는 의도적으로 돌리지 않는다.
set -e

ROOT=$(git rev-parse --show-toplevel)

python3 "$ROOT/scripts/check-boundary.py" || {
    echo "공개 경계 위반으로 커밋을 막았다. 해당 위치를 고친 뒤 다시 커밋한다"
    exit 1
}

python3 "$ROOT/scripts/check-adr.py" >/dev/null || {
    echo "ADR 규약 검사 실패. python3 scripts/check-adr.py 로 상세를 본다"
    exit 1
}
